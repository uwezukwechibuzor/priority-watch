<clickhouse>
    <!-- Listen on all interfaces inside Docker -->
    <listen_host>0.0.0.0</listen_host>

    <!-- Expose Prometheus metrics on a dedicated port so Prometheus can scrape
         without touching the HTTP query interface. -->
    <prometheus>
        <endpoint>/metrics</endpoint>
        <port>9363</port>
        <metrics>true</metrics>
        <events>true</events>
        <asynchronous_metrics>true</asynchronous_metrics>
    </prometheus>

    <!-- Memory cap for the server process; tune per host in production. -->
    <max_server_memory_usage_to_ram_ratio>0.8</max_server_memory_usage_to_ram_ratio>

    <!-- Query profiles referenced by users.d/pw-users.xml -->
    <profiles>
        <default>
            <max_memory_usage>4294967296</max_memory_usage>  <!-- 4 GiB -->
            <max_execution_time>120</max_execution_time>
            <use_uncompressed_cache>0</use_uncompressed_cache>
            <load_balancing>random</load_balancing>
        </default>

        <readonly>
            <readonly>1</readonly>
            <max_execution_time>30</max_execution_time>
            <max_memory_usage>1073741824</max_memory_usage>  <!-- 1 GiB -->
        </readonly>
    </profiles>
</clickhouse>
