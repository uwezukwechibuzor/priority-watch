<clickhouse>
    <!-- Listen on all interfaces inside Docker -->
    <listen_host>0.0.0.0</listen_host>

    <!-- Expose Prometheus metrics on a dedicated port so Prometheus can scrape
         without touching the HTTP query interface. -->
    <prometheus>
        <endpoint>/metrics</endpoint>
        <port>9363</port>
        <metrics>true</metrics>
        <events>true</events>
        <asynchronous_metrics>true</asynchronous_metrics>
    </prometheus>

    <!-- Backup disk for pw_clickhouse_backup DAG.  Maps to the host path
         bound via the clickhouse-backups volume in docker-compose.yml. -->
    <storage_configuration>
        <disks>
            <backups>
                <type>local</type>
                <path>/var/lib/clickhouse/backups/</path>
            </backups>
        </disks>
    </storage_configuration>
    <backups>
        <allowed_disk>backups</allowed_disk>
        <allowed_path>/var/lib/clickhouse/backups/</allowed_path>
    </backups>

    <!-- Memory cap: 50% of RAM to leave headroom for merges and system tables. -->
    <max_server_memory_usage_to_ram_ratio>0.5</max_server_memory_usage_to_ram_ratio>

    <!-- Disable all system log tables to prevent OOM crashes on low-RAM hosts. -->
    <query_log remove="1"/>
    <query_thread_log remove="1"/>
    <query_views_log remove="1"/>
    <part_log remove="1"/>
    <trace_log remove="1"/>
    <processors_profile_log remove="1"/>
    <latency_log remove="1"/>
    <metric_log remove="1"/>
    <asynchronous_metric_log remove="1"/>
    <opentelemetry_span_log remove="1"/>
    <crash_log remove="1"/>
    <text_log remove="1"/>
    <query_metric_log remove="1"/>

    <!-- Query profiles are defined in users.d/pw-profiles.xml -->
</clickhouse>
