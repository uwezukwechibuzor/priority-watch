# ── Data source selection ─────────────────────────────────────────────────────
# Primary data source for block ingestion: sqd | hypersync | rpc | sqd+hypersync
# sqd           uses SQD Portal (free, no auth required) — default
# hypersync     uses Envio HyperSync (free tier, token optional)
# rpc           uses Arbitrum JSON-RPC (requires ARBITRUM_RPC_URL)
# sqd+hypersync tries SQD first, falls back to HyperSync on error
BLOCK_SOURCE=sqd

# ── SQD Portal ────────────────────────────────────────────────────────────────
SQD_PORTAL_URL=https://portal.sqd.dev/datasets/arbitrum-one

# ── Envio HyperSync ───────────────────────────────────────────────────────────
ENVIO_HYPERSYNC_URL=https://arbitrum.hypersync.xyz
# Optional: API token for higher rate limits on HyperSync
ENVIO_API_TOKEN=

# ── Arbitrum One RPC ──────────────────────────────────────────────────────────
# Required only when BLOCK_SOURCE=rpc. Still used for fee-recipient balance
# snapshots and task 8 on-chain samples under the free-indexer sources.
# Paid/pay-as-you-go plan required; Arbitrum produces ~4 blocks/s — free tiers
# cannot keep up with full RPC backfills (SQD/HyperSync have no such limit).
ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY

# Comma-separated fallback RPC URLs (tried in order on primary failure)
ARBITRUM_RPC_FALLBACK_URLS=https://arbitrum-one.publicnode.com

# WebSocket URL for the live block follower
ARBITRUM_WS_URL=wss://arb-mainnet.g.alchemy.com/v2/YOUR_KEY

# Max requests per second to the primary RPC (respect your plan's rate limit)
ARBITRUM_RPC_RPS=50

# ── ClickHouse ────────────────────────────────────────────────────────────────
CLICKHOUSE_ADDR=localhost:9000
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# Read-only credentials for the API and dbt
CLICKHOUSE_RO_USER=pw_reader
CLICKHOUSE_RO_PASSWORD=

# dbt connection (host and port separately; used by dbt/profiles.yml)
# Also used by Airflow DAGs via clickhouse-connect (HTTP port 8123)
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
DBT_PROFILES_DIR=./dbt

# ── Postgres (Airflow metadata) ───────────────────────────────────────────────
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow

# ── Airflow ───────────────────────────────────────────────────────────────────
AIRFLOW_ADMIN_PASSWORD=admin

# ── API ───────────────────────────────────────────────────────────────────────
API_PORT=8080
API_CORS_ORIGIN=http://localhost:5173

# ── Binance CEX prices ────────────────────────────────────────────────────────
# Comma-separated symbols for 1s klines (ETH/USD required)
BINANCE_SYMBOLS=ETHUSDT

# ── Chain parameters ──────────────────────────────────────────────────────────
# PGA activation block (filled in task 8 after on-chain verification)
PGA_ACTIVATION_BLOCK=

# ── Airflow monitoring ────────────────────────────────────────────────────────
# URL for pw_monitoring to health-check the live follower
FOLLOWER_HEALTHZ_URL=http://pw-follower:9091/healthz

# ClickHouse backup disk name (must match infra/clickhouse/config.d/pw-config.xml)
CLICKHOUSE_BACKUP_DISK=backups

# ── Ops ───────────────────────────────────────────────────────────────────────
DOMAIN=priority.watch
ACME_EMAIL=you@example.com

# Slack webhook for Airflow alerts (optional; leave empty to disable)
SLACK_WEBHOOK_URL=
